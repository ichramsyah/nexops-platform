# ============================================================
# NexOps Platform — .gitignore
# ============================================================

# GCP Credentials — NEVER commit these
credentials.json
*.json.key
*.p12
service-account-*.json

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Kubeconfig — generated by Ansible
kubeconfig.yaml
*.kubeconfig

# Ansible
*.retry
ansible/inventory/hosts.ini.bak
ansible/.vault_password

# Environment secrets
.env
.env.*
*.secret

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
trivy-*.txt
trivy-*.json

token-github.txt
token-sonar.txt